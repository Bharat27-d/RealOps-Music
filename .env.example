# ─── Discord Configuration ─────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
# Optional: restrict command deployment to one guild during development
DEV_GUILD_ID=
# Comma-separated list of Discord user IDs with owner-level permissions
OWNER_IDS=123456789012345678,987654321098765432

# ─── Logging ────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Lavalink Client (Bot Configuration) ────────────────────────────────────────
# JSON array of node definitions.
# Each entry: { name, host, port, password, secure, role }
# role: "primary" | "residential"
#
# Topology A: Single Hetzner Node
# LAVALINK_NODES=[{"name":"primary","host":"127.0.0.1","port":2333,"password":"youshallnotpass","secure":false,"role":"primary"}]
#
# Topology B: Dual Node (Hetzner Primary + Residential over Tailscale/WireGuard)
# LAVALINK_NODES=[{"name":"primary","host":"lavalink","port":2333,"password":"youshallnotpass","secure":false,"role":"primary"},{"name":"residential","host":"100.64.0.2","port":2333,"password":"youshallnotpass","secure":false,"role":"residential"}]
LAVALINK_NODES=[{"name":"primary","host":"127.0.0.1","port":2333,"password":"youshallnotpass","secure":false,"role":"primary"}]

# ─── Lavalink Server Host Settings ──────────────────────────────────────────────
LAVALINK_SERVER_PORT=2333
LAVALINK_SERVER_PASSWORD=youshallnotpass
LAVALINK_JVM_OPTS=-Xmx2G -XX:+UseG1GC

# ─── LavaSrc Plugin (Spotify Metadata Resolution) ───────────────────────────────
# Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── youtube-source Plugin (YouTube Hardening) ──────────────────────────────────
# First-run flow outputs refresh token to terminal. Set here for persistence:
YOUTUBE_OAUTH_REFRESH_TOKEN=
# Optional: Proof-of-Origin token and Visitor Data extracted via browser devtools:
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# ─── Datacenter IP Mitigation (Hetzner IPv6 Route Planner) ─────────────────────
# Assigned /64 IPv6 subnet from Hetzner (leave empty if not using IPv6 rotation)
HETZNER_IPV6_BLOCK=

# ─── Queue Limits & Player Policy ──────────────────────────────────────────────
MAX_QUEUE_SIZE=500
MAX_PER_USER_QUEUE=20
MAX_PLAYLIST_TRACKS=100
# Minutes of silence / empty voice channel before the bot disconnects
IDLE_TIMEOUT_MINUTES=5
