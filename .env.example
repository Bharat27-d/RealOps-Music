# Default Bot Settings
DEFAULT_VOLUME=80
DEFAULT_SEARCH_PLATFORM=ytmsearch
AUTO_DISCONNECT_EMPTY_SECONDS=180
AUTO_DISCONNECT_IDLE_SECONDS=300
DEFAULT_247_MODE=false

